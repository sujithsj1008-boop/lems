# Copy these into your backend host's environment settings; do not commit real values.
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=https://your-site.netlify.app
FRONTEND_URL=https://your-site.netlify.app
MYSQLHOST=your-mysql-host
MYSQLUSER=your-mysql-user
MYSQLPASSWORD=your-mysql-password
MYSQLDATABASE=lems_db
MYSQLPORT=3306
# Optional email configuration
EMAIL_USER=
EMAIL_PASS=
# Set only when provisioning the first administrator; remove after successful creation.
BOOTSTRAP_ADMIN_ID=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Lab Admin
# Optional secret for the ESP32 kiosk
KIOSK_API_KEY=
